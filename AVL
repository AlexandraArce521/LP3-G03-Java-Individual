class NodoAVL {
    int clave;           // Valor almacenado en el nodo
    int altura;          // Altura del nodo en el árbol
    NodoAVL izquierdo;   // Hijo izquierdo
    NodoAVL derecho;     // Hijo derecho

    NodoAVL(int clave) {
        this.clave = clave;
        this.altura = 1; // Los nuevos nodos empiezan con altura 1
    }
}

public class ArbolAVL {
    private NodoAVL raiz; // Nodo raíz del árbol

    // Devuelve la altura de un nodo, o 0 si es null
    private int altura(NodoAVL nodo) {
        return (nodo == null) ? 0 : nodo.altura;
    }

    // Calcula el factor de balance:
    // altura izquierda - altura derecha
    private int factorBalance(NodoAVL nodo) {
        return (nodo == null) ? 0 : altura(nodo.izquierdo) - altura(nodo.derecho);
    }

    // Actualiza la altura de un nodo según sus hijos
    private void actualizarAltura(NodoAVL nodo) {
        nodo.altura = Math.max(altura(nodo.izquierdo),
                               altura(nodo.derecho)) + 1;
    }

    // Rotación a la derecha
    // Se usa cuando el árbol está cargado hacia la izquierda
    private NodoAVL rotacionDerecha(NodoAVL y) {

        NodoAVL x = y.izquierdo; // Nueva raíz después de la rotación
        NodoAVL T2 = x.derecho;  // Subárbol temporal

        // Realizar rotación
        x.derecho = y;
        y.izquierdo = T2;

        // Actualizar alturas
        actualizarAltura(y);
        actualizarAltura(x);

        // Retorna la nueva raíz
        return x;
    }

    // Rotación a la izquierda
    // Se usa cuando el árbol está cargado hacia la derecha
    private NodoAVL rotacionIzquierda(NodoAVL x) {

        NodoAVL y = x.derecho;   // Nueva raíz después de la rotación
        NodoAVL T2 = y.izquierdo; // Subárbol temporal

        // Realizar rotación
        y.izquierdo = x;
        x.derecho = T2;

        // Actualizar alturas
        actualizarAltura(x);
        actualizarAltura(y);

        // Retorna la nueva raíz
        return y;
    }

    // Método público para insertar una clave
    public void insertar(int clave) {
        raiz = insertar(raiz, clave);
    }

    // Inserción recursiva con balanceo
    private NodoAVL insertar(NodoAVL nodo, int clave) {

        // PASO 1:
        // Inserción normal de un Árbol Binario de Búsqueda (BST)
        if (nodo == null)
            return new NodoAVL(clave);

        if (clave < nodo.clave) {
            nodo.izquierdo = insertar(nodo.izquierdo, clave);

        } else if (clave > nodo.clave) {
            nodo.derecho = insertar(nodo.derecho, clave);

        } else {
            // No se permiten duplicados
            return nodo;
        }

        // PASO 2:
        // Actualizar la altura del nodo actual
        actualizarAltura(nodo);

        // PASO 3:
        // Obtener el factor de balance
        int balance = factorBalance(nodo);

        // PASO 4:
        // Revisar si el árbol quedó desbalanceado
        // y aplicar rotaciones

        // CASO IZQUIERDA-IZQUIERDA (LL)
        // El desbalance ocurrió en el hijo izquierdo
        // y la inserción también fue por la izquierda
        if (balance > 1 && clave < nodo.izquierdo.clave)
            return rotacionDerecha(nodo);

        // CASO DERECHA-DERECHA (RR)
        // El desbalance ocurrió en el hijo derecho
        // y la inserción también fue por la derecha
        if (balance < -1 && clave > nodo.derecho.clave)
            return rotacionIzquierda(nodo);

        // CASO IZQUIERDA-DERECHA (LR)
        // Primero rotación izquierda
        // Luego rotación derecha
        if (balance > 1 && clave > nodo.izquierdo.clave) {

            nodo.izquierdo = rotacionIzquierda(nodo.izquierdo);

            return rotacionDerecha(nodo);
        }

        // CASO DERECHA-IZQUIERDA (RL)
        // Primero rotación derecha
        // Luego rotación izquierda
        if (balance < -1 && clave < nodo.derecho.clave) {

            nodo.derecho = rotacionDerecha(nodo.derecho);

            return rotacionIzquierda(nodo);
        }

        // Retorna el nodo sin cambios
        return nodo;
    }
}